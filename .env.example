# ---------- FREE option: Google Gemini (key from aistudio.google.com) ----------
LLM_API_KEY=your-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=openai/gemini-2.5-flash
# Daily free limit hit? Each model has its own daily counter. Try another model,
# for example:  MODEL=openai/gemini-2.5-flash-lite
# (copy exact model names from https://aistudio.google.com/rate-limit)

TOPIC=Introduction to CrewAI

# ---------- Optional settings ----------
# MAX_RPM=8                # max AI requests per minute (lower it if you get 429 errors)
# SEARCH_REGION=in-en      # search region: in-en (India), us-en, wt-wt (worldwide)
# RESEARCHER_MODEL=        # use a different (bigger) model only for the Researcher

# ---------- If you use OpenAI later, use these 3 lines instead ----------
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# MODEL=gpt-4o-mini
